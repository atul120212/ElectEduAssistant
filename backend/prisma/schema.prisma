generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  passwordHash  String?
  sessionId     String   @unique
  displayName   String?
  location      String?
  language      String   @default("en")
  preferences   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  conversations Conversation[]
  quizResults   QuizResult[]
  bookmarks     Bookmark[]
  reminders     Reminder[]
  feedback      Feedback[]
  
  @@index([sessionId])
  @@index([email])
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  title       String?
  summary     String?
  country     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  
  @@index([userId, createdAt])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  role            String       // 'user' or 'assistant'
  content         String       @db.Text
  metadata        Json?        // sources, citations, etc.
  timestamp       DateTime     @default(now())
  
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, timestamp])
}

model Quiz {
  id          String       @id @default(uuid())
  topic       String
  difficulty  String       // 'easy', 'medium', 'hard'
  questions   Json         // Array of question objects
  createdAt   DateTime     @default(now())
  
  results     QuizResult[]
  
  @@index([topic, difficulty])
}

model QuizResult {
  id              String   @id @default(uuid())
  quizId          String
  userId          String
  answers         Json     // User's answers
  score           Int
  totalQuestions  Int
  timeSpent       Int?     // seconds
  completedAt     DateTime @default(now())
  
  quiz            Quiz     @relation(fields: [quizId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId, completedAt])
  @@index([quizId])
}

model Topic {
  id          String     @id @default(uuid())
  title       String
  category    String
  difficulty  String
  content     String     @db.Text
  country     String?
  keywords    String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  bookmarks   Bookmark[]
  
  @@index([category, difficulty])
  @@index([country])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@unique([userId, topicId])
}

model TimelineEvent {
  id          String     @id @default(uuid())
  country     String
  state       String?
  title       String
  description String?
  eventDate   DateTime
  eventType   String     // 'registration', 'early_voting', 'election_day', etc.
  isRecurring Boolean    @default(false)
  metadata    Json?
  
  reminders   Reminder[]
  
  @@index([country, eventDate])
  @@index([state, eventDate])
}

model Reminder {
  id            String        @id @default(uuid())
  userId        String
  eventId       String
  notifyBefore  Int           // days before event
  notified      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([userId, notified])
  @@index([eventId])
}

model Feedback {
  id            String   @id @default(uuid())
  userId        String?
  messageId     String?
  rating        Int      // 1-5
  comment       String?  @db.Text
  feedbackType  String   // 'helpful', 'not_helpful', 'bug', 'suggestion'
  createdAt     DateTime @default(now())
  
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([createdAt, feedbackType])
}

model Analytics {
  id          String   @id @default(uuid())
  eventType   String   // 'page_view', 'chat_message', 'quiz_started', etc.
  userId      String?
  metadata    Json?
  timestamp   DateTime @default(now())
  
  @@index([eventType, timestamp])
  @@index([userId, timestamp])
}
